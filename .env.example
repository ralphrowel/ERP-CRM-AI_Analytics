# ==============================================================================
# ERP/CRM Environment Configuration Template
# Copy this file to .env and adjust variables as needed:
#   copy .env.example .env (Windows) or cp .env.example .env (Linux/macOS)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database Connection (PostgreSQL 16)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=erp_crm
POSTGRES_USER=erp_app
POSTGRES_PASSWORD=erp_app_password
POSTGRES_OWNER_USER=erp_owner
POSTGRES_OWNER_PASSWORD=erp_owner_password

# Application Connection String (DML operations)
DATABASE_URL=postgresql+psycopg://erp_app:erp_app_password@localhost:5432/erp_crm

# Migration Connection String (DDL operations via Alembic)
MIGRATION_DATABASE_URL=postgresql+psycopg://erp_owner:erp_owner_password@localhost:5432/erp_crm

# Security & Sessions
# Must be at least 32 characters in production
SECRET_KEY=change-this-in-production-secret-key-min-32-chars-long!
SESSION_COOKIE_NAME=erp_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_IDLE_HOURS=8
SESSION_ABSOLUTE_DAYS=7

# Bootstrap Admin / Superuser
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=AdminPassword123!
FIRST_SUPERUSER_NAME=System Administrator

# Frontend & CORS
# In dev, Vite proxies /api to backend; in prod, Caddy reverse-proxies
FRONTEND_URL=http://localhost:5173
