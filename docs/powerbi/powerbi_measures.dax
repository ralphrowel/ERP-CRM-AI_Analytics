// =============================================================================
// Power BI DAX Measures Catalog (Roadmap §V1.5 & §11)
// Auto-generated by analytics.bi.dax engine
// =============================================================================

// --- KPI-001: KPI-001 Net Revenue (REVENUE) ---
// Total accrual net revenue excluding VAT: sum of issued/paid invoices minus issued credit notes.
[KPI-001 Net Revenue] =
    SUM(fact_sales_line[net_revenue])

[KPI-001 Net Revenue MTD] =
    TOTALMTD([KPI-001 Net Revenue], dim_date[date])

[KPI-001 Net Revenue YTD] =
    TOTALYTD([KPI-001 Net Revenue], dim_date[date])

[KPI-001 Net Revenue PY] =
    CALCULATE([KPI-001 Net Revenue], SAMEPERIODLASTYEAR(dim_date[date]))

[KPI-001 Net Revenue YoY_Growth] =
    DIVIDE([KPI-001 Net Revenue] - [KPI-001 Net Revenue PY], [KPI-001 Net Revenue PY], 0)

[KPI-001 Net Revenue MoM_Growth] =
    DIVIDE([KPI-001 Net Revenue] - CALCULATE([KPI-001 Net Revenue], DATEADD(dim_date[date], -1, MONTH)), CALCULATE([KPI-001 Net Revenue], DATEADD(dim_date[date], -1, MONTH)), 0)

// --- KPI-002: KPI-002 Gross Margin (REVENUE) ---
// Net Revenue minus cost of goods sold (COGS).
[KPI-002 Gross Margin] =
    SUM(fact_sales_line[gross_margin])

[KPI-002 Gross Margin YTD] =
    TOTALYTD([KPI-002 Gross Margin], dim_date[date])

[KPI-002 Gross Margin PY] =
    CALCULATE([KPI-002 Gross Margin], SAMEPERIODLASTYEAR(dim_date[date]))

[KPI-002 Gross Margin YoY_Growth] =
    DIVIDE([KPI-002 Gross Margin] - [KPI-002 Gross Margin PY], [KPI-002 Gross Margin PY], 0)

// --- KPI-003: KPI-003 Gross Margin % (REVENUE) ---
// Gross Margin as a percentage of Net Revenue.
[KPI-003 Gross Margin %] =
    DIVIDE([KPI-002 Gross Margin], [KPI-001 Net Revenue], 0)

[KPI-003 Gross Margin % YTD] =
    DIVIDE([KPI-002 Gross Margin YTD], [KPI-001 Net Revenue YTD], 0)

// --- KPI-004: KPI-004 Orders (SALES) ---
// Count of distinct confirmed customer sales orders in the period.
[KPI-004 Orders] =
    DISTINCTCOUNT(fact_sales_line[invoice_no])

[KPI-004 Orders MTD] =
    TOTALMTD([KPI-004 Orders], dim_date[date])

[KPI-004 Orders YTD] =
    TOTALYTD([KPI-004 Orders], dim_date[date])

[KPI-004 Orders PY] =
    CALCULATE([KPI-004 Orders], SAMEPERIODLASTYEAR(dim_date[date]))

// --- KPI-005: KPI-005 AR Outstanding (AR) ---
// Total outstanding accounts receivable balances on unpaid or partially paid invoices.
[KPI-005 AR Outstanding] =
    SUM(fact_ar_allocation[amount])

// --- KPI-006: KPI-006 AR Aging (AR) ---
// Accounts receivable balance categorized by days past due date (current, 1-30, 31-60, 61-90, 90+).
[KPI-006 AR Aging] =
    CALCULATE(SUM(fact_ar_allocation[amount]), FILTER(fact_ar_allocation, fact_ar_allocation[days_after_due] > 0))

// --- KPI-007: KPI-007 Weighted Pipeline (CRM) ---
// Sum of opportunity estimated amounts weighted by stage probability.
[KPI-007 Weighted Pipeline] =
    SUM(fact_opportunity_stage[estimated_amount])

// --- KPI-008: KPI-008 Win Rate (CRM) ---
// Ratio of won opportunities to total closed (won + lost) opportunities in the period.
[KPI-008 Win Rate] =
    VAR WonCount = CALCULATE(COUNTROWS(fact_opportunity_stage), fact_opportunity_stage[to_stage] = "closed_won") VAR ClosedCount = CALCULATE(COUNTROWS(fact_opportunity_stage), fact_opportunity_stage[to_stage] IN {"closed_won", "closed_lost"}) RETURN DIVIDE(WonCount, ClosedCount, 0)

// --- KPI-009: KPI-009 Lead Conversion Rate (CRM) ---
// Ratio of converted leads to total leads created in the cohort.
[KPI-009 Lead Conversion Rate] =
    VAR Converted = CALCULATE(COUNTROWS(fact_opportunity_stage), fact_opportunity_stage[from_stage] = "lead_qualification") VAR Total = COUNTROWS(fact_opportunity_stage) RETURN DIVIDE(Converted, Total, 0)

// --- KPI-010: KPI-010 Avg Sales Cycle (CRM) ---
// Average days elapsed from opportunity creation to closed-won milestone.
[KPI-010 Avg Sales Cycle] =
    AVERAGE(fact_opportunity_stage[days_in_previous_stage])

// --- KPI-011: KPI-011 Active Customers (CUSTOMER) ---
// Count of distinct customers with at least one transaction in the trailing 12 months.
[KPI-011 Active Customers] =
    CALCULATE(DISTINCTCOUNT(fact_sales_line[customer_key]), DATESINPERIOD(dim_date[date], MAX(dim_date[date]), -12, MONTH))

// --- KPI-012: KPI-012 New Customers (CUSTOMER) ---
// Count of customers whose initial transaction occurred during the evaluated period.
[KPI-012 New Customers] =
    VAR CurrentCust = VALUES(fact_sales_line[customer_key]) VAR PriorCust = CALCULATE(VALUES(fact_sales_line[customer_key]), FILTER(ALL(dim_date), dim_date[date] < MIN(dim_date[date]))) RETURN COUNTROWS(EXCEPT(CurrentCust, PriorCust))

// --- KPI-013: KPI-013 Inventory Value (INVENTORY) ---
// Total on-hand inventory valuation at standard cost as of latest snapshot date.
[KPI-013 Inventory Value] =
    CALCULATE(SUM(fact_inventory_daily[inventory_value]), LASTDATE(fact_inventory_daily[date_key]))

// --- KPI-014: KPI-014 Inventory Turnover (INVENTORY) ---
// Trailing 12-month COGS divided by average inventory valuation.
[KPI-014 Inventory Turnover] =
    VAR T12COGS = CALCULATE(SUM(fact_sales_line[cogs]), DATESINPERIOD(dim_date[date], MAX(dim_date[date]), -12, MONTH)) VAR AvgInv = AVERAGE(fact_inventory_daily[inventory_value]) RETURN DIVIDE(T12COGS, AvgInv, 0)

// --- KPI-015: KPI-015 Low-Stock Items (INVENTORY) ---
// Count of product-warehouse combinations where available quantity is below safety stock.
[KPI-015 Low-Stock Items] =
    COUNTROWS(FILTER(fact_inventory_daily, fact_inventory_daily[qty_on_hand] <= 10))

// --- KPI-016: KPI-016 Purchase Spend (PURCHASING) ---
// Total procurement spend across purchase order line items in the period.
[KPI-016 Purchase Spend] =
    SUM(fact_purchase_line[cost])

[KPI-016 Purchase Spend MTD] =
    TOTALMTD([KPI-016 Purchase Spend], dim_date[date])

[KPI-016 Purchase Spend YTD] =
    TOTALYTD([KPI-016 Purchase Spend], dim_date[date])

// --- KPI-017: KPI-017 Supplier On-Time Rate (PURCHASING) ---
// Percentage of purchase order deliveries completed on or before expected delivery date.
[KPI-017 Supplier On-Time Rate] =
    VAR OnTimeLines = CALCULATE(COUNTROWS(fact_purchase_line), fact_purchase_line[days_late] <= 0) VAR TotalLines = COUNTROWS(fact_purchase_line) RETURN DIVIDE(OnTimeLines, TotalLines, 0)

// --- KPI-018: KPI-018 DSO (AR) ---
// Days Sales Outstanding: AR Outstanding divided by (Net Revenue in last 90 days / 90).
[KPI-018 DSO] =
    VAR Rev90 = CALCULATE(SUM(fact_sales_line[net_revenue]), DATESINPERIOD(dim_date[date], MAX(dim_date[date]), -90, DAY)) VAR DailyRev = DIVIDE(Rev90, 90, 0) RETURN DIVIDE([KPI-005 AR Outstanding], DailyRev, 0)

// --- KPI-019: KPI-019 Data Quality Score (DQ) ---
// Weighted pass rate score across all evaluated data quality rules (0 to 100).
[KPI-019 Data Quality Score] =
    AVERAGE(dq_results[score])
