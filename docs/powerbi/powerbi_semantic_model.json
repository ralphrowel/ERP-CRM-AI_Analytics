      "table": "fact_purchase_line",
      "expression": "VAR OnTimeLines = CALCULATE(COUNTROWS(fact_purchase_line), fact_purchase_line[days_late] <= 0) VAR TotalLines = COUNTROWS(fact_purchase_line) RETURN DIVIDE(OnTimeLines, TotalLines, 0)",
      "format_string": "0.0%",
      "time_intelligence": {}
    },
    {
      "kpi_id": "KPI-018",
